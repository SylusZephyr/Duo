{
  "name": "Duo — a private space for two",
  "short_name": "Duo",
  "description": "Share moments, map the places you've been, keep a journal, and mark your milestones — just the two of you.",
  "id": "/",
  "start_url": "/feed",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
