# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Supabase -------------------------------------------------------------
# From your project's API settings. The publishable (anon) key is safe in a
# browser: row-level security, not key secrecy, is what protects the data.
# Both the VITE_ and bare forms are needed — the client reads the first, the
# SSR/server bundle the second.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=your-project-ref

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_PROJECT_ID=your-project-ref

# --- Google Maps ----------------------------------------------------------
# Two separate keys, because they are exposed differently.
#
# The browser key ships in the page and loads the map. It cannot be hidden, so
# restrict it by HTTP referrer to your own domains in the Google Cloud console
# and enable only "Maps JavaScript API" on it.
VITE_GOOGLE_MAPS_BROWSER_KEY=AIza-browser-key

# The server key is used only by server functions (place search and reverse
# geocoding) and never reaches a browser. Restrict it by IP where you can, and
# enable "Places API (New)" and "Geocoding API" on it.
GOOGLE_MAPS_API_KEY=AIza-server-key
